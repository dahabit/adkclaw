{
  "name": "adkclaw",
  "version": "1.0.0",
  "description": "Autonomous AI agent framework on Google ADK + Gemini — lives on Telegram, remembers across sessions, self-heals, and orchestrates sub-agents.",
  "license": "Apache-2.0",
  "author": "Ahmed Abu Eldahab",
  "homepage": "https://adkclaw.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dahabit/adkclaw.git"
  },
  "bugs": {
    "url": "https://github.com/dahabit/adkclaw/issues"
  },
  "keywords": [
    "ai-agent",
    "autonomous-agent",
    "google-adk",
    "gemini",
    "agent-framework",
    "telegram-bot",
    "llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "adkclaw": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "workspace.example",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:dist": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup": "tsx src/cli/setup.ts",
    "chat": "tsx src/cli/repl.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:security": "tsx scripts/audit-security.ts",
    "link": "npm run build && npm link",
    "prepublishOnly": "npm test && npm run build:dist"
  },
  "dependencies": {
    "@google-cloud/dlp": "^6.6.1",
    "@google/genai": "^2.0.0",
    "@types/pdfkit": "^0.17.6",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-auth-library": "^10.6.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.18.0",
    "playwright": "^1.59.1",
    "telegraf": "^4.16.3",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
