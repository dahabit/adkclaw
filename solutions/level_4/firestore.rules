rules_version = '2';

// Default-deny. The agent reaches Firestore through the Cloud Run runtime
// service account, whose IAM bypasses these rules — so these rules are
// defence-in-depth: if SA-bypass is ever disabled, no client gets in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /sessions/{sessionKey} {
      allow read, write: if false;
    }

    match /messages/{messageId} {
      allow read, write: if false;
    }

    match /cron_runs/{runId} {
      allow read, write: if false;
    }
  }
}
