{
  "id": "L2-memory-recall",
  "level": 2,
  "intent": "If the user told the agent their name in a previous turn, asking 'what's my name?' should recall it via memory_recall (not just rely on history).",
  "preconditions": {
    "session": "eval-l2-recall",
    "fixtures": ["bank/people/eval-user.md"]
  },
  "input": {
    "userText": "What's my name?"
  },
  "asserts": [
    { "type": "tool_called", "name": "memory_recall" },
    { "type": "reply_length_gt", "value": 5 },
    { "type": "reply_length_lt", "value": 500 }
  ]
}
