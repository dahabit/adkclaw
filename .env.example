# === Required ===

# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram numeric user IDs (get yours from @userinfobot).
# Empty = bot rejects everyone — set this before starting.
ALLOWED_SENDERS=

# === Server ===
PORT=3000
HOST=localhost

# === Workspace + data ===
WORKSPACE_PATH=./workspace
DATABASE_PATH=./data/adkclaw.db

# === Agent defaults ===
DEFAULT_MODEL=gemini-3.1-pro-preview
FALLBACK_MODEL=gemini-3-flash-preview
MAX_TOOL_ROUNDS=15
COMPACTION_THRESHOLD=0.8
HEARTBEAT_INTERVAL_MS=1800000
TIMEZONE=Africa/Cairo

# === Budget guard (Paperclip pattern) ===
DAILY_TOKEN_BUDGET=500000

# === Optional: Vertex AI (Workshop 3+) ===
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# === Optional: Workshop platform badge reporting ===
# Set these to have your agent automatically report level completions to the
# AdkClaw cohort fleet at adkclaw.dev. Get them by registering at:
#   https://adkclaw.dev/join/sandbox
# (or your instructor's event code).
#
# The HMAC secret is shown ONCE at registration. Save it here.
# If unset, the agent runs fine — it just doesn't show up on the cohort fleet.
ADKCLAW_USERNAME=
ADKCLAW_BUILDER_SECRET=
ADKCLAW_API_BASE=https://api.adkclaw.dev
