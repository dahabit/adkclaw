# === Required ===

# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram numeric user IDs (get yours from @userinfobot).
# Empty = bot rejects everyone — set this before starting.
ALLOWED_SENDERS=

# === Server ===
PORT=3000
HOST=localhost

# === Workspace + data ===
WORKSPACE_PATH=./workspace
DATABASE_PATH=./data/adkclaw.db

# === Agent defaults ===
DEFAULT_MODEL=gemini-2.5-pro
FALLBACK_MODEL=gemini-2.5-flash
MAX_TOOL_ROUNDS=15
COMPACTION_THRESHOLD=0.8
HEARTBEAT_INTERVAL_MS=1800000
TIMEZONE=Africa/Cairo

# === Budget guard (Paperclip pattern) ===
DAILY_TOKEN_BUDGET=500000

# === Optional: Vertex AI (Workshop 3+) ===
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
