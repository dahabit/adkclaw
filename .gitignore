out/
build/

# === Environment (NEVER commit these) ===
.env
.env.local
.env.*.local
!.env.example
agent.yaml
config.json
set_env.sh

# === Runtime data (per-user; never commit) ===
data/
workspace/
!workspace.example/
output/
**/*.db
**/*.db-journal
**/*.pid

# === OS / editor ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# === Secrets / certs (CRITICAL) ===
*.pem
*.key
*.p12
service-account.json
gcp-credentials.json
**/credentials/

# === Test / coverage ===
coverage/
.nyc_output/
.cache/

