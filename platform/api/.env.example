# AdkClaw API — environment variables

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Google Cloud / Firestore
GOOGLE_CLOUD_PROJECT=adkclaw-prod
# When running locally with the emulator, also set:
# FIRESTORE_EMULATOR_HOST=localhost:8085

# Auth
INSTRUCTOR_TOKEN=replace-with-strong-random-string
# A pre-shared admin token for creating events. Rotate after first event creation.

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGIN=http://localhost:3000,https://adkclaw.dev

# Logging
LOG_LEVEL=info
