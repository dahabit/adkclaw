#!/usr/bin/env bash
# adkclaw — convenience wrapper to run the agent from anywhere
#
# Add to PATH:
#   export PATH="$HOME/agents/adkclaw/bin:$PATH"
# Or symlink:
#   ln -s "$(pwd)/bin/adkclaw" /usr/local/bin/adkclaw

set -e

# Resolve the project root by following the symlink (if any) of this script
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null && pwd )"
PROJECT_ROOT="$( dirname "$SCRIPT_DIR" )"

cd "$PROJECT_ROOT"

PORT="$(grep -E '^PORT=' .env 2>/dev/null | head -1 | cut -d= -f2 || echo 3000)"
: "${PORT:=3000}"

case "${1:-help}" in
  start|daemon)
    echo "🤖 Starting AdkClaw daemon (foreground)…"
    exec npx tsx src/index.ts
    ;;

  bg|background)
    if pgrep -f "tsx src/index.ts" > /dev/null; then
      echo "⚠️  Daemon already running. Use \`adkclaw stop\` first."
      exit 1
    fi
    mkdir -p data
    echo "🤖 Starting AdkClaw in background…"
    nohup npx tsx src/index.ts > data/adkclaw.log 2>&1 &
    PID=$!
    echo "$PID" > data/adkclaw.pid
    sleep 2
    if kill -0 "$PID" 2>/dev/null; then
      echo "✓ Started (PID $PID). Logs: tail -f data/adkclaw.log"
      echo "  Stop:  adkclaw stop"
    else
      echo "✗ Failed to start. Check data/adkclaw.log"
      exit 1
    fi
    ;;

  stop)
    if [ -f data/adkclaw.pid ]; then
      PID=$(cat data/adkclaw.pid)
      if kill -0 "$PID" 2>/dev/null; then
        kill "$PID"
        rm -f data/adkclaw.pid
        echo "✓ Stopped (PID $PID)"
      else
        echo "Daemon not running (stale PID file)"
        rm -f data/adkclaw.pid
      fi
    else
      pkill -f "tsx src/index.ts" 2>/dev/null && echo "✓ Stopped" || echo "Daemon not running"
    fi
    ;;

  restart)
    "$0" stop
    sleep 1
    "$0" bg
    ;;

  setup)
    exec npx tsx src/cli/setup.ts
    ;;

  chat)
    exec npx tsx src/cli/repl.ts
    ;;

  check|doctor)
    exec npx tsx src/cli/index.ts check
    ;;

  status)
    if command -v jq >/dev/null 2>&1; then
      curl -s "http://localhost:$PORT/api/status" | jq .
    else
      curl -s "http://localhost:$PORT/api/status"
    fi
    ;;

  logs)
    if [ -f data/adkclaw.log ]; then
      tail -f data/adkclaw.log
    elif command -v pm2 >/dev/null 2>&1 && pm2 list 2>/dev/null | grep -q adkclaw; then
      pm2 logs adkclaw
    elif command -v journalctl >/dev/null 2>&1; then
      journalctl -fu adkclaw
    else
      echo "No log source found (no data/adkclaw.log, no pm2, no systemd)"
      exit 1
    fi
    ;;

  pm2-start)
    npm run build
    pm2 start dist/index.js --name adkclaw
    pm2 save
    echo "✓ Running under pm2. Use \`pm2 logs adkclaw\` to follow."
    ;;

  pm2-stop)
    pm2 stop adkclaw
    ;;

  open|dashboard)
    URL="http://localhost:$PORT/"
    echo "$URL"
    if command -v open >/dev/null 2>&1; then open "$URL"
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL"
    fi
    ;;

  help|-h|--help|"")
    cat <<EOF
🤖 adkclaw — autonomous agent CLI

USAGE:
  adkclaw <command>

DAEMON:
  start         Run in foreground (Ctrl+C to stop)
  bg            Run in background (nohup, persists across terminal close)
  stop          Stop the background daemon
  restart       Stop + start (background)
  pm2-start     Run under pm2 (survives reboots — needs \`npm i -g pm2\`)
  pm2-stop      Stop the pm2 process

INTERACT:
  chat          Open the terminal REPL
  check         Pre-flight diagnostics (env + daemon ping)
  status        Show /api/status as JSON
  logs          Tail logs (data/adkclaw.log or pm2 / systemd)
  open          Open the admin dashboard in your browser

CONFIG:
  setup         Interactive wizard — name your agent, configure keys

PROJECT ROOT: $PROJECT_ROOT
EOF
    ;;

  *)
    echo "Unknown command: $1"
    "$0" help
    exit 1
    ;;
esac
